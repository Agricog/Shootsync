{
  "name": "shootsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "prisma generate && npm run build:client && npm run build:site && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/server/index.js",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=test-results.tap \"tests/**/*.test.ts\"",
    "build:site": "node scripts/prerender.mjs && node scripts/check-built-site.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.11.4",
    "@clerk/clerk-react": "5.61.10",
    "@prisma/client": "5.22.0",
    "@sentry/node": "11.10.0",
    "@sentry/react": "11.10.0",
    "cors": "2.8.6",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "jspdf": "4.2.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "7.18.5",
    "stripe": "14.25.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "concurrently": "8.2.2",
    "postcss": "8.5.30",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "@clerk/shared": false,
    "core-js": false
  }
}
