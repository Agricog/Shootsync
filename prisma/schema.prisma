generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ENTITIES
// ============================================

model Syndicate {
  id                  String   @id @default(cuid())
  name                String
  captainClerkId      String   @map("captain_clerk_id")
  /// Clauses this syndicate adds to the standard guest acknowledgement (server/waiver.ts). Migration 0004.
  waiverExtra         String?  @map("waiver_extra")
  seasonStart         DateTime @map("season_start")
  seasonEnd           DateTime @map("season_end")
  subscriptionAmount  Int      @default(0) @map("subscription_amount")
  subscriptionType    SubscriptionType @default(ANNUAL) @map("subscription_type")
  
  // Stripe subscription fields
  stripeCustomerId           String?  @map("stripe_customer_id")
  stripeSubscriptionId       String?  @map("stripe_subscription_id")
  stripePriceId              String?  @map("stripe_price_id")
  stripeSubscriptionStatus   StripeSubscriptionStatus? @map("stripe_subscription_status")
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end")
  /// A card dispute (chargeback) is open on a payment: read-only until a payment arrives (migration 0005).
  disputeOpenedAt            DateTime? @map("dispute_opened_at")
  /// When the card first failed this time round: full use for 14 days from here (migration 0005).
  pastDueSince               DateTime? @map("past_due_since")
  planTier                   PlanTier? @map("plan_tier")
  /// When the plan ended: everything is deleted 90 days later, after the captain is offered the export (0006).
  planEndedAt                DateTime? @map("plan_ended_at")
  
  /// Whole pounds. Kept in step with the pence by a database trigger until a later migration drops it (0007).
  defaultBeaterRate   Int      @default(40) @map("default_beater_rate")
  /// What a new beater starts on, in pence (0007). The column the code reads and writes.
  defaultBeaterRatePence Int   @default(4000) @map("default_beater_rate_pence")
  pegRotationRule     PegRotationRule @default(FAIR_ROTATION) @map("peg_rotation_rule")
  status              SyndicateStatus @default(ACTIVE)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  members             Member[]
  beaters             Beater[]
  shootDays           ShootDay[]
  beaterPayments      BeaterPayment[]
  memberPayments      MemberPayment[]
  beaterBookings      BeaterBooking[]
  activityLogs        ActivityLog[]
  deletionWarnings    DeletionWarning[]

  @@index([captainClerkId])
  @@map("syndicates")
}

model Member {
  id                    String   @id @default(cuid())
  syndicateId           String   @map("syndicate_id")
  clerkUserId           String   @map("clerk_user_id")
  email                 String
  name                  String
  phone                 String?
  role                  MemberRole @default(GUN)
  bascNumber            String?  @map("basc_number")
  insuranceExpiry       DateTime? @map("insurance_expiry")
  insuranceDocument     String?  @map("insurance_document")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  subscriptionStatus    PaymentStatus @default(PENDING) @map("subscription_status")
  subscriptionPaidDate  DateTime? @map("subscription_paid_date")
  invitedAt             DateTime? @map("invited_at")
  acceptedAt            DateTime? @map("accepted_at")
  status                MemberStatus @default(PENDING)
  /// When the member left: starts the retention clock (0006).
  leftAt                DateTime? @map("left_at")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  syndicate             Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  shootAttendances      ShootAttendance[]
  guestsInvited         GuestGun[] @relation("InvitedBy")
  bagRecords            BagRecord[]
  memberPayments        MemberPayment[]
  activityLogs          ActivityLog[]

  @@unique([syndicateId, clerkUserId])
  @@index([clerkUserId])
  @@index([syndicateId, status])
  @@map("members")
}

model Beater {
  id                String   @id @default(cuid())
  syndicateId       String   @map("syndicate_id")
  name              String
  email             String?
  phone             String?
  /// Whole pounds. Kept in step with the pence by a database trigger until a later migration drops it (0007).
  dayRate           Int      @default(40) @map("day_rate")
  /// The beater's day rate in pence (0007). The column the code reads and writes.
  dayRatePence      Int      @default(4000) @map("day_rate_pence")
  bankName          String?  @map("bank_name")
  bankSortCode      String?  @map("bank_sort_code")
  bankAccountNumber String?  @map("bank_account_number")
  /// Sort code and account number, sealed (server/bankCrypto.ts). The readable columns above are
  /// emptied at boot and dropped in a later migration (0006).
  bankDetailsSealed String?  @map("bank_details_sealed")
  /// The last four digits of the account number, shown in its place (0006).
  bankAccountLast4  String?  @map("bank_account_last4")
  /// When the beater stopped working for the syndicate: starts the retention clock (0006).
  leftAt            DateTime? @map("left_at")
  status            BeaterStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  syndicate         Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  payments          BeaterPayment[]
  bookings          BeaterBooking[]

  @@index([syndicateId, status])
  @@map("beaters")
}

model ShootDay {
  id                String   @id @default(cuid())
  syndicateId       String   @map("syndicate_id")
  date              DateTime
  locationName      String   @map("location_name")
  locationAddress   String?  @map("location_address")
  locationPostcode  String?  @map("location_postcode")
  locationWhat3Words String? @map("location_what3words")
  meetTime          String   @default("08:30") @map("meet_time")
  drivesPlanned     Int      @default(4) @map("drives_planned")
  expectedBag       Int?     @map("expected_bag")
  status            ShootStatus @default(SCHEDULED)
  weatherNotes      String?  @map("weather_notes")
  captainNotes      String?  @map("captain_notes")
  briefingGenerated Boolean  @default(false) @map("briefing_generated")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  syndicate         Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  attendances       ShootAttendance[]
  guestGuns         GuestGun[]
  bagRecords        BagRecord[]
  beaterPayments    BeaterPayment[]
  beaterBookings    BeaterBooking[]

  @@index([syndicateId, date])
  @@map("shoot_days")
}

model ShootAttendance {
  id            String   @id @default(cuid())
  shootId       String   @map("shoot_id")
  memberId      String   @map("member_id")
  roleOnDay     MemberRole @default(GUN) @map("role_on_day")
  pegNumber     Int?     @map("peg_number")
  confirmed     Boolean  @default(false)
  attended      Boolean  @default(false)
  checkedInAt   DateTime? @map("checked_in_at")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shootDay      ShootDay @relation(fields: [shootId], references: [id], onDelete: Cascade)
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([shootId, memberId])
  @@index([memberId])
  @@map("shoot_attendances")
}

model GuestGun {
  id                    String   @id @default(cuid())
  shootId               String   @map("shoot_id")
  invitedByMemberId     String   @map("invited_by_member_id")
  name                  String
  email                 String
  phone                 String?
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  pegNumber             Int?     @map("peg_number")
  dayFee                Int      @default(5000) @map("day_fee")
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  stripePaymentId       String?  @map("stripe_payment_id")
  waiverAccepted        Boolean  @default(false) @map("waiver_accepted")
  waiverAcceptedAt      DateTime? @map("waiver_accepted_at")
  /// Which acknowledgement text the guest accepted (server/waiver.ts version) and a SHA-256 of the
  /// exact words shown, including the syndicate's own clauses. Migration 0004.
  waiverVersion         String?  @map("waiver_version")
  waiverTextHash        String?  @map("waiver_text_hash")
  /// The exact words accepted, kept whole: a hash alone can't be read back once a syndicate edits its clauses (migration 0005).
  waiverText            String?  @map("waiver_text")
  rsvpStatus            RsvpStatus @default(PENDING) @map("rsvp_status")
  /// SHA-256 (hex) of the token in the guest's link (server/inviteTokens.ts), never the token itself (0007).
  inviteToken           String?  @unique @map("invite_token")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Restrict: a signed acknowledgement or a payment can never be wiped by deleting the day or
  // the member. The shoot-day delete route removes un-accepted invitations itself first.
  shootDay              ShootDay @relation(fields: [shootId], references: [id], onDelete: Restrict)
  invitedByMember       Member   @relation("InvitedBy", fields: [invitedByMemberId], references: [id], onDelete: Restrict)

  @@index([shootId])
  @@index([invitedByMemberId])
  @@map("guest_guns")
}

model BagRecord {
  id                String   @id @default(cuid())
  shootId           String   @map("shoot_id")
  driveNumber       Int      @map("drive_number")
  pheasant          Int      @default(0)
  partridge         Int      @default(0)
  duck              Int      @default(0)
  woodcock          Int      @default(0)
  other             Int      @default(0)
  otherDescription  String?  @map("other_description")
  recordedByMemberId String?  @map("recorded_by_member_id")
  recordedAt        DateTime @default(now()) @map("recorded_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shootDay          ShootDay @relation(fields: [shootId], references: [id], onDelete: Restrict)
  recordedBy        Member?  @relation(fields: [recordedByMemberId], references: [id], onDelete: SetNull)

  @@index([shootId])
  @@index([recordedByMemberId])
  @@map("bag_records")
}

model BeaterPayment {
  id               String   @id @default(cuid())
  syndicateId      String   @map("syndicate_id")
  beaterId         String   @map("beater_id")
  shootId          String   @map("shoot_id")
  amount           Int
  status           PaymentStatus @default(PENDING)
  paidDate         DateTime? @map("paid_date")
  paymentReference String?  @map("payment_reference")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  syndicate        Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  // Restrict: money owed or paid is never wiped by deleting the beater or the day.
  beater           Beater    @relation(fields: [beaterId], references: [id], onDelete: Restrict)
  shootDay         ShootDay  @relation(fields: [shootId], references: [id], onDelete: Restrict)

  // One payment record per beater per day: a beater can never be paid twice for one day.
  @@unique([beaterId, shootId])
  @@index([syndicateId, status])
  @@index([shootId])
  @@map("beater_payments")
}

model MemberPayment {
  id              String   @id @default(cuid())
  syndicateId     String   @map("syndicate_id")
  memberId        String   @map("member_id")
  amount          Int
  paymentType     MemberPaymentType @default(SUBSCRIPTION) @map("payment_type")
  status          PaymentStatus @default(PENDING)
  dueDate         DateTime? @map("due_date")
  paidDate        DateTime? @map("paid_date")
  paymentMethod   PaymentMethod? @map("payment_method")
  stripePaymentId String?  @map("stripe_payment_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  syndicate       Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([syndicateId, status])
  @@index([memberId])
  @@map("member_payments")
}

model BeaterBooking {
  id            String   @id @default(cuid())
  syndicateId   String   @map("syndicate_id")
  beaterId      String   @map("beater_id")
  shootId       String   @map("shoot_id")
  /// Whole pounds. Kept in step with the pence by a database trigger until a later migration drops it (0007).
  dayRate       Int      @default(0) @map("day_rate")
  /// The rate agreed for this day, in pence (0007). The column the code reads and writes.
  dayRatePence  Int      @default(0) @map("day_rate_pence")
  status        BookingStatus @default(INVITED)
  invitedAt     DateTime @default(now()) @map("invited_at")
  confirmedAt   DateTime? @map("confirmed_at")
  checkedIn     Boolean  @default(false) @map("checked_in")
  checkedInAt   DateTime? @map("checked_in_at")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  syndicate     Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  beater        Beater    @relation(fields: [beaterId], references: [id], onDelete: Cascade)
  shootDay      ShootDay  @relation(fields: [shootId], references: [id], onDelete: Cascade)

  @@unique([beaterId, shootId])
  @@index([shootId])
  @@index([syndicateId])
  @@map("beater_bookings")
}

/// The audit trail (server/audit.ts). Entries are never changed (a database trigger refuses it,
/// migration 0006); the retention job removes them when their time is up. No personal values:
/// what happened, to which record, by whom (IDs), and which fields changed (names only).
model ActivityLog {
  id            String   @id @default(cuid())
  syndicateId   String   @map("syndicate_id")
  /// What happened, in words: "Shoot day changed", "Bank details revealed".
  action        String
  actorMemberId String?  @map("actor_member_id")
  /// The signed-in user (Clerk ID), or 'stripe' / 'guest' / 'system'.
  actorUserId   String?  @map("actor_user_id")
  /// captain, gun, guest, stripe or system.
  actorRole     String?  @map("actor_role")
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  details       Json?
  timestamp     DateTime @default(now())

  syndicate     Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  actor         Member?   @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([syndicateId, timestamp])
  @@index([syndicateId, targetId])
  @@map("activity_logs")
}

/// Each email warning that a syndicate's records are about to be deleted (server/deletionWarnings.ts,
/// migration 0008). One per syndicate, deletion date and warning, so none is sent twice. No personal data.
model DeletionWarning {
  id            String   @id @default(cuid())
  syndicateId   String   @map("syndicate_id")
  /// The deletion date the warning was about. A plan started and ended again gives a new one.
  deletionDueAt DateTime @map("deletion_due_at")
  /// 30, 7 or 1.
  daysBefore    Int      @map("days_before")
  /// 'pending' (claimed, being sent), 'sent', 'no_email' (the captain's account had no address;
  /// alerted) or 'superseded' (never confirmed, replaced by a more urgent warning).
  outcome       String
  /// When this server took the claim. A 'pending' claim older than a few minutes is taken again.
  claimedAt     DateTime @map("claimed_at")
  /// When Resend accepted it. Set exactly when the outcome is 'sent'.
  sentAt        DateTime? @map("sent_at")

  syndicate     Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)

  @@unique([syndicateId, deletionDueAt, daysBefore])
  @@map("deletion_warnings")
}

// ============================================
// SCHEMA VERSION
// ============================================

/// When each signed-in Clerk session first and last used ShootSync (server/sessionPolicy.ts), so
/// the server ends a session 15 minutes after it started, and one left idle. Migration 0003.
model SessionActivity {
  sessionId   String   @id @map("session_id")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@map("session_activity")
}

/// One row per migration applied to this database (prisma/migrations/<id>/migration.sql ends by
/// inserting its own row). The server refuses to start without the migration its code needs.
model SchemaMigration {
  id        String   @id
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("schema_migrations")
}

// ============================================
// ENUMS
// ============================================

enum SubscriptionType {
  ANNUAL
  PER_SHOOT
  HYBRID
}

enum PegRotationRule {
  FAIR_ROTATION
  RANDOM
  MANUAL
}

enum SyndicateStatus {
  ACTIVE
  ARCHIVED
}

enum MemberRole {
  CAPTAIN
  GUN
  BEATER
  HYBRID
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum BeaterStatus {
  ACTIVE
  INACTIVE
}

enum ShootStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum BookingStatus {
  INVITED
  CONFIRMED
  DECLINED
  NO_SHOW
}

enum MemberPaymentType {
  SUBSCRIPTION
  GUEST_FEE
  OTHER
}

enum PaymentMethod {
  BANK_TRANSFER
  STRIPE
  CASH
}

enum StripeSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
  TRIALING
  /// Stripe stopped retrying a failed payment (migration 0002).
  UNPAID
}

enum PlanTier {
  STARTER
  STANDARD
}

